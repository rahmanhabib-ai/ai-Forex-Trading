# -----------------------------------------------------------------------------
# ChartLogic Pro (Forex AI News Enterprise Terminal) - Environment Configuration
# Add these variables to Hostinger Node.js "Environment Variables" (or your .env file)
# -----------------------------------------------------------------------------

# Application Environment & Port
NODE_ENV=production
PORT=3000

# Canonical Production URL (Hostinger Custom Domain)
APP_URL=https://chartlogic.pro

# Google Gemini AI Engine API Key
# Get your free/production API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# System Master Administrator Email
ADMIN_EMAIL=contact@aibangla.com.bd

# Application Security & Session Secret
SESSION_SECRET=chartlogic_secure_session_secret_change_in_production
